root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,jsonc,toml}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

[*.{c,h,cpp,hpp,cc,hh}]
indent_size = 4

[Makefile]
indent_style = tab

[*.{bat,cmd,ps1}]
end_of_line = crlf
